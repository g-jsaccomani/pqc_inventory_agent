# Google Cloud / Vertex AI Configuration for Google ADK & Gemini 3.1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=pqc-inventory-agent-cd06
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_STAGING_BUCKET=gs://pqc-inventory-agent-cd06-pqc-agent-staging

# Default GCP Organization Scope
GCP_ORGANIZATION_ID=31564119954
GCP_ORGANIZATION_NAME=jsaccomani.altostrat.com

# Default PQC Agent Model (Gemini 3.1 CustomTools Preview)
PQC_AGENT_MODEL=gemini-3.1-pro-preview-customtools

# Simulation mode (never a silent fallback):
# - "FALSE" (default): live Cloud KMS / Cloud Asset Inventory only. API errors are returned explicitly.
# - "TRUE": demo dataset for offline demos and unit tests. Every payload is labeled SIMULATED_DEMO_DATASET.
# Explicit demo scopes (e.g. "demo-pqc-project") always return the labeled demo dataset.
PQC_SIMULATION_MODE=FALSE

# Portal authentication (see pqc_agent/auth_guard.py). Secure defaults shown.
# Email-only sign-in is a development-only escape hatch; keep false everywhere else.
PQC_ALLOW_UNVERIFIED_SIGNIN=false
# ADK DevServer (/dev-ui, /dev/apps/*) and ADK-native REST routes (/list-apps, /apps/..., /run...).
# Unset = enabled only when not running on Cloud Run (K_SERVICE unset); they always require a signed-in user.
# PQC_ENABLE_ADK_DEV_UI=true
# PQC_ENABLE_ADK_API=true
# Comma-separated cross-origin allowlist (unset = same-origin portal only; wildcards are ignored).
# PQC_ALLOWED_ORIGINS=https://portal.example.com
# HMAC key for signed sessions / OAuth state (inject from Secret Manager in production; >= 32 random chars).
# PQC_AUTH_SECRET=
# Expected Cloud IAP JWT audience when deployed behind IAP (/projects/<num>/global/backendServices/<id>).
# PQC_IAP_AUDIENCE=
# Administrators allowed to change the global OAuth client (comma-separated emails).
# PQC_ADMIN_EMAILS=
# Optional: accepted Google ID-token audiences (OAuth client IDs), comma-separated.
# PQC_GOOGLE_ID_TOKEN_AUDIENCES=
