# ==============================================================================
# Agentic PQC Workspace — Environment Configuration Template (NO REAL SECRETS)
# ==============================================================================

# 1. Google Cloud / Vertex AI Configuration for Google ADK & Gemini
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=pqc-inventory-agent-cd06
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_STAGING_BUCKET=gs://pqc-inventory-agent-cd06-pqc-agent-staging
PQC_ARTIFACT_BUCKET=gs://pqc-inventory-agent-cd06-pqc-agent-staging

# 2. Default GCP Organization Scope & Model
GCP_ORGANIZATION_ID=31564119954
GCP_ORGANIZATION_NAME=jsaccomani.altostrat.com
PQC_AGENT_MODEL=gemini-3.1-pro-preview-customtools
PQC_SIMULATION_MODE=FALSE

# 3. Transactional Persistence (Cloud SQL for PostgreSQL — Required in Production)
# Option A (Cloud Run Unix Socket via Cloud SQL Auth Proxy):
# PQC_CLOUD_SQL_CONNECTION_NAME=pqc-inventory-agent-cd06:us-central1:pqc-postgres-prod
# PQC_DB_NAME=pqc_workspace
# PQC_DB_USER=pqc_app
# PQC_DB_PASSWORD=                 # Inject from Secret Manager in production; never commit real passwords
#
# Option B (Direct PostgreSQL DSN, e.g. Private IP / Local PostgreSQL):
# DATABASE_URL=postgresql+psycopg://pqc_app:<SECRET_FROM_SECRET_MANAGER>@10.x.x.x:5432/pqc_workspace?sslmode=require
#
# Local Development ONLY (strictly rejected when K_SERVICE or PQC_PRODUCTION_MODE=true is set; never use /data):
# DATABASE_URL=sqlite:///./data/pqc_local_dev.db

# PostgreSQL Connection Pool & Timeout Controls
PQC_DB_POOL_SIZE=5
PQC_DB_MAX_OVERFLOW=10
PQC_DB_POOL_TIMEOUT=15
PQC_DB_POOL_RECYCLE=1800
PQC_DB_CONNECT_TIMEOUT=10
PQC_DB_STATEMENT_TIMEOUT_MS=30000

# 4. Distributed Authentication & Session Security (Phase 1)
PQC_ALLOW_UNVERIFIED_SIGNIN=false
PQC_ENABLE_GIS_JAVASCRIPT_CLIENT=false
# PQC_ENABLE_ADK_DEV_UI=false
# PQC_ENABLE_ADK_API=false
# PQC_ALLOWED_ORIGINS=https://portal.example.com
# Inject >= 32-char CSPRNG secret from Secret Manager in production:
# PQC_AUTH_SECRET=
# Expected Cloud IAP JWT audience (/projects/<PROJECT_NUMBER>/locations/<REGION>/services/<SERVICE>):
# PQC_IAP_AUDIENCE=
# Comma-separated administrator emails permitted to update OAuth client config:
# PQC_ADMIN_EMAILS=
# Accepted Google OAuth 2.0 Client IDs for ID token verification:
# PQC_GOOGLE_ID_TOKEN_AUDIENCES=
# PQC_GOOGLE_OAUTH_CLIENT_ID=
# PQC_GOOGLE_OAUTH_CLIENT_SECRET=  # Inject from Secret Manager

# 5. Credential Architecture & Cloud KMS Envelope Encryption (Phase 2 / ID-01)
# Preferred GCP access mode: short-lived read-only Service Account Impersonation ('impersonation') or 'adc'.
# Optional comma-separated allowlist of permitted impersonation target SAs (exact email or @project.iam.gserviceaccount.com):
# PQC_ALLOWED_IMPERSONATION_SERVICE_ACCOUNTS=pqc-scanner-sa@pqc-inventory-agent-cd06.iam.gserviceaccount.com
#
# Required in production for AES-256-GCM DEK wrapping of persisted 3LO delegated credentials & OAuth client secrets:
# PQC_KMS_KEY_NAME=projects/pqc-inventory-agent-cd06/locations/us-central1/keyRings/pqc-portal-kr/cryptoKeys/pqc-cred-kek
